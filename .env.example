# --- CORS & Domain Boundary Security ---
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://goldenglobalexpo.com,https://www.goldenglobalexpo.com

# --- Outbound SMTP Mail Dispatch Rails ---
