# ==============================================================================
# GOLDEN GLOBAL EXPO — PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env' and populate with institutional credentials before deployment.
# Reference: HANDOVER_MANUAL.md
# ==============================================================================

# --- Application Runtime Environment ---
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# --- Database Storage Configuration ---
# Production PostgreSQL connection string:
# DATABASE_URL=postgresql://gge_admin:gge_prod_secure_vault_2026@db:5432/gge_production
# Local Development / Test SQLite connection:
DATABASE_URL=sqlite:///data/enterprise.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# --- High-Concurrency Multi-Worker Redis Cluster (Optional) ---
# When deployed across multi-instance clusters, provide Redis endpoint:
# REDIS_URL=redis://redis:6379/0

# --- Institutional Authentication & Access Control ---
# Primary administrator password for Trade Desk (/desk.html):
ADMIN_PASSWORD=GoldenAdmin2026!

# Dedicated logistics/consignment staff password:
LOGISTICS_PASSWORD=Logistics2026!

# Cryptographic master bypass key (leave blank or unset to disable in production):
MASTER_SECURITY_KEY=

# Cryptographic JWT signing secret (minimum 32 characters):
JWT_SECRET=gge_enterprise_secure_token_signing_key_2026_super_secret

# Authorized administrative email list (comma-separated):
