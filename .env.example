# ==============================================================================
# GOLDEN GLOBAL EXPO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with your production credentials
# ==============================================================================

ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Database (Default: SQLite WAL mode. For Postgres: postgresql://user:pass@host/db)
DATABASE_URL=sqlite:///./data/enterprise.db

# Cryptographic Keys
SECRET_KEY=your_cryptographic_secret_key_here
SESSION_EXPIRE_SECONDS=86400

# Executive Access Control & Authentication
ADMIN_EMAILS=export@goldenglobalexpo.com,admin@goldenglobalexpo.com
ADMIN_PASSWORD=GoldenAdmin2026!
ADMIN_MASTER_CODE=your_emergency_code_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Outbound SMTP Engine
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=exports@goldenglobalexpo.com
DEFAULT_SENDER_NAME=Golden Global Expo ★ Official Trade Desk
DEFAULT_REPLY_TO=exports@goldenglobalexpo.com

# Forex Telemetry
FOREX_UPSTREAM_URL=https://open.er-api.com/v6/latest/USD
FOREX_CACHE_TTL_SECONDS=1800
