{
  "name": "golden-global-expo",
  "version": "2.4.0",
  "description": "Enterprise agricultural export trading house and domestic distribution platform",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project=mobile-safari",
    "test:load": "k6 run tests/load/k6-test.js",
    "test:load:smoke": "k6 run --env SCENARIO=smoke tests/load/k6-test.js",
    "test:load:spike": "k6 run --env SCENARIO=spike tests/load/k6-test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
